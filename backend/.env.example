PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/office_hrm?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# Office Geofence Coordinates
OFFICE_LAT=28.6193386
OFFICE_LNG=77.0293531
OFFICE_RADIUS=100

# Wabridge WhatsApp API Configuration
WABRIDGE_APP_KEY=your_wabridge_app_key
WABRIDGE_AUTH_KEY=your_wabridge_auth_key
WABRIDGE_DEVICE_ID=your_wabridge_device_id
WABRIDGE_OTP_TEMPLATE_ID=2114436642782977

# Gmail SMTP Email Notification
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Cloudflare R2 Credentials (Evidence Storage)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
